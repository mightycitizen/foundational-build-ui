{
  "name": "mc-foundation-build",
  "version": "2.0.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "concurrently --raw \"pnpm watch\" \"pnpm storybook\"",
    "watch": "npx tailwindcss -i ./src/assets/css/app.css -o ./src/assets/css/output.css --watch",
    "component": "hygen foundation component",
    "js": "hygen foundation javascript",
    "js-plugin": "hygen foundation javascript-plugin",
    "storybook": "storybook dev -p 6011",
    "build": "storybook build"
  },
  "browserslist": [
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/register": "^7.29.7",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "add-attributes-twig-extension": "^0.1.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^7.6.0",
    "drupal-twig-extensions": "1.0.0-beta.5",
    "phosphor-icons-tailwindcss": "^1.2.2",
    "sharp": "^0.35.5",
    "storybook": "10.6.1",
    "svgo": "^4",
    "tailwindcss": "^3.4.19",
    "twig-drupal-filters": "^3.2.0",
    "vite": "^7.3.7",
    "vite-plugin-twig-drupal": "^1.6.2"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.17.4",
    "@alpinejs/focus": "^3.17.4",
    "@alpinejs/intersect": "^3.17.4",
    "@splidejs/splide": "^4.1.4",
    "@storybook/html-vite": "10.6.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/typography": "^0.5.20",
    "alpinejs": "^3.17.4",
    "cssnano": "^7.1.9",
    "drupal-attribute": "^1.2.1",
    "litepicker": "^2.0.12",
    "twig": "^1.17.1",
    "vite-plugin-image-optimizer": "^2.0.3"
